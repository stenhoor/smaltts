{
  "name": "@smaltworks/smaltts",
  "version": "0.0.1",
  "private": true,
  "description": "smaltts: a database-first, plan-first TypeScript API for the smaltdb engine",
  "author": "stenhoor",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./language": {
      "types": "./dist/language.d.ts",
      "default": "./dist/language.js"
    },
    "./worker": {
      "types": "./dist/worker.d.ts",
      "default": "./dist/worker.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "deps": "node scripts/fetch-packed.mjs",
    "test": "node scripts/fetch-packed.mjs --check && vitest run",
    "check": "npm test",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "test:browser": "node test/browser/run.mjs"
  },
  "peerDependencies": {
    "smaltdb": ">=0.9.0 <0.10.0"
  },
  "peerDependenciesMeta": {
    "smaltdb": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "smaltty": "github:stenhoor/smaltty#78eb49eeb79bb1b039ef23cd1349c541bdb0d74b",
    "vitepress": "^1.6.4",
    "vitest": "^5.0.5"
  }
}
